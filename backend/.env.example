# Copy to .env and fill in. .env is gitignored.

# --- MCP transport ---
# Stateless mode drops per-session state so any App Runner instance can serve any
# request. Required once the service scales past one instance; costs server->client
# notifications and resumability. Keep false locally, true in deployment.
MACROMATE_MCP_STATELESS=false

# Comma-separated Host header allowlist (DNS-rebinding protection).
# Add the App Runner domain before deploying or every request 400s.
MACROMATE_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Server ---
MACROMATE_PORT=8080
MACROMATE_LOG_LEVEL=INFO

# --- Bedrock ---
# Claude on Bedrock needs per-account, per-region model enablement. Request it on
# day 1 -- see docs/tech-stack-decision.md section 7, risk 3.
AWS_REGION=us-east-1
MACROMATE_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Database (not yet wired; pending Kiro spec) ---
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/macromate
