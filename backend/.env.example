# Copy to .env and fill in. .env is gitignored.

# --- MCP transport ---
# Stateless mode drops per-session state so any App Runner instance can serve any
# request. Required once the service scales past one instance; costs server->client
# notifications and resumability. Keep false locally, true in deployment.
MACROMATE_MCP_STATELESS=false

# Comma-separated Host header allowlist (DNS-rebinding protection).
# Add the App Runner domain before deploying or every request 400s.
MACROMATE_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Server ---
MACROMATE_PORT=8080
MACROMATE_LOG_LEVEL=INFO

# --- Bedrock ---
# Claude on Bedrock is now auto-enabled on first invocation (no manual request needed
# as of 2026-09-18). Run scripts/spike_bedrock.py to verify access.
AWS_REGION=us-east-1
MACROMATE_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Database ---
# Postgres via asyncpg. RDS endpoint once provisioned; use localhost for local dev.
MACROMATE_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/macromate

# --- Nutrition data sources ---
# USDA FoodData Central: https://fdc.nal.usda.gov/api-guide.html
# Request a free key at https://api.data.gov/signup/
MACROMATE_USDA_API_KEY=your-usda-api-key-here

# Open Food Facts is unauthenticated (no key required).

# --- OAuth (Alexa+ account-linking) ---
# OAuth 2.0 M2M (client_credentials) + user PKCE flows required by Alexa+ MCP.
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
MACROMATE_OAUTH_CLIENT_ID=macromate-alexa
MACROMATE_OAUTH_CLIENT_SECRET=your-oauth-client-secret-here
MACROMATE_OAUTH_ISSUER=https://your-apprunner-domain.awsapprunner.com
